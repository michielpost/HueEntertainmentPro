{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "ingress-root": {
        "ClusterId": "hue-server",
        "Match": { "Path": "/ingress/{token}" },
        "Transforms": [
          { "PathSet": "/" }
        ]
      },
      "ingress-paths": {
        "ClusterId": "hue-server",
        "Match": { "Path": "/ingress/{token}/{**rest}" },
        "Transforms": [
          { "PathPattern": "/{**rest}" }
        ]
      }
    },
    "Clusters": {
      "hue-server": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5159/"
          }
        }
      }
    }
  }
}
