@inherits LayoutComponentBase

<FluentLayout Class="page-layout" Height="100dvh">
    <FluentLayoutItem Area="LayoutArea.Header" Class="app-header">
        <FluentLayoutHamburger PanelHeader="Hue Entertainment Pro" />
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12px">
            <FluentIcon Value="@(new Icons.Regular.Size24.Lightbulb())" />
            <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Semibold">Hue Entertainment Pro</FluentText>
        </FluentStack>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation" Class="nav-area">
        <NavMenu />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Class="body-content">
        <ErrorBoundary>
            <ChildContent>
                <div class="content">
                    @Body
                </div>
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="blazor-error-boundary">@ex.Message</div>
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer" Class="app-footer">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16px">
            <a href="https://github.com/michielpost/HueEntertainmentPro" target="_blank" class="footer-link">
                <FluentIcon Value="@(new Icons.Regular.Size16.Branch())" />
                <span>GitHub</span>
            </a>
            <FluentSpacer />
            <a href="https://x.com/michielpostnl" target="_blank" class="footer-link">
                <FluentIcon Value="@(new Icons.Regular.Size16.Person())" />
                <span>Created by Michiel Post</span>
            </a>
        </FluentStack>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />
