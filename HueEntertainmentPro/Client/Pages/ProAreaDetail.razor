@page "/proarea/{Id:guid}"
@using HueEntertainmentPro.Shared.Interfaces
@using HueEntertainmentPro.Shared.Models
@using HueEntertainmentPro.Shared.Models.Requests
@using HueLightDJ.Services.Interfaces
@using HueLightDJ.Services.Interfaces.Models
@inject IBridgeDataService BridgeService
@inject IProAreaDataService ProAreaDataService
@inject IHueSetupService HueSetupService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject INotificationService NotificationService

<PageTitle>Pro Entertainment Area</PageTitle>

<h1>Pro Entertainment Area</h1>

@if (errorMessage != null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Style="margin-bottom: 16px;">
        @errorMessage
    </FluentMessageBar>
}

@if (proArea != null)
{
    <FluentCard Class="page-card" Style="padding: 1.5rem; margin-bottom: 1.5rem;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
            <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Semibold">@proArea.Name</FluentText>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10px" Style="margin-top: 8px;">
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ShowEditNameDialog" IconStart="@(new Icons.Regular.Size16.Edit())">Edit Name</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" @onclick="ShowDeleteConfirmation" IconStart="@(new Icons.Regular.Size16.Delete())">Delete Area</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <h3>Entertainment Groups</h3>
    @if (proArea.Connections.Any())
    {
        <FluentCard Class="page-card" Appearance="CardAppearance.Subtle" Style="padding: 1rem;">
            <FluentDataGrid Items="@proArea.Connections.AsQueryable()"
                            RowSize="@DataGridRowSize.Medium"
                            TGridItem="BridgeGroupConnection">
                <PropertyColumn Title="IP" Property="@(g => g.Bridge.Ip)" Sortable="true" Align="DataGridCellAlignment.Start" />
                <PropertyColumn Title="Bridge" Property="@(g => g.Bridge.Name)" Sortable="true" Align="DataGridCellAlignment.Start" />
                <PropertyColumn Title="Entertainment Group" Property="@(g => g.Name)" Sortable="true" Align="DataGridCellAlignment.Start" />
                <TemplateColumn Title="Action" Align="DataGridCellAlignment.End">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px">
                        <FluentButton Appearance="ButtonAppearance.Default" @onclick="() => RemoveConnection(context.Id)" IconStart="@(new Icons.Regular.Size16.Delete())">Remove</FluentButton>
                        <FluentButton @onclick="() => IdentifyGroup(context.Bridge.Id, context.GroupId)" IconStart="@(new Icons.Regular.Size16.Lightbulb())">Identify</FluentButton>
                    </FluentStack>
                </TemplateColumn>
            </FluentDataGrid>
        </FluentCard>
    }
    else
    {
        <FluentText As="TextTag.Paragraph">No entertainment groups found for this area.</FluentText>
    }

    <h3>Add Entertainment Groups</h3>

    @if (HasDisabledBridges && HasEnabledBridges)
    {
        <FluentMessageBar Intent="MessageBarIntent.Warning" Style="margin-bottom: 16px;">
            Some bridges are disabled because they are already connected to this area.
        </FluentMessageBar>
    }
    else if (!HasEnabledBridges)
    {
        <FluentMessageBar Intent="MessageBarIntent.Warning" Style="margin-bottom: 16px;">
            All bridges are already connected to this area. Add more bridges to add more entertainment groups.
            <FluentLink Href="bridges">Go to Bridges</FluentLink>
        </FluentMessageBar>
    }

    @if (HasEnabledBridges)
    {
        <FluentCard Class="page-card" Style="padding: 1rem; margin-bottom: 1rem;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                <FluentText As="TextTag.Paragraph" Weight="TextWeight.Semibold">Select a bridge</FluentText>
                <FluentListbox Items="@bridges"
                               TOption="Bridge"
                               TValue="string"
                               OptionText="@(b => $"{b.Name} ({b.Ip})")"
                               OptionDisabled="@(b => proArea.Connections.Select(x => x.Bridge.Id).Contains(b.Id))"
                               OptionValue="@(b => b.Id.ToString())"
                               Value="@selectedBridgeValue"
                               ValueChanged="@(async (string bridge) => await OnBridgeIdSelected(bridge))" />
            </FluentStack>
        </FluentCard>

        @if (selectedBridge != null)
        {
            <h4>Entertainment Groups for @selectedBridge.Name</h4>
            @if (entertainmentGroups == null)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px" VerticalAlignment="VerticalAlignment.Center">
                    <FluentSpinner />
                    <FluentText As="TextTag.Paragraph">Loading entertainment groups...</FluentText>
                </FluentStack>
            }
            else if (entertainmentGroups.Any())
            {
                <FluentCard Class="page-card" Appearance="CardAppearance.Subtle" Style="padding: 1rem;">
                    <FluentDataGrid Items="@entertainmentGroups"
                                    AutoFit="true"
                                    RowSize="@DataGridRowSize.Medium"
                                    TGridItem="SimpleEntertainmentGroup">
                        <TemplateColumn Title="Action" Align="DataGridCellAlignment.Start">
                            <FluentButton @onclick="() => AddToArea(selectedBridge.Id, context.Id, context.Name)" IconStart="@(new Icons.Regular.Size16.Add())">Add</FluentButton>
                        </TemplateColumn>
                        <PropertyColumn Title="Name" Property="@(g => g.Name)" Sortable="true" Align="DataGridCellAlignment.Start" />
                        <PropertyColumn Title="Lights" Property="@(g => g.LightCount)" Sortable="true" Align="DataGridCellAlignment.Start" />
                        <TemplateColumn Title="Identify" Align="DataGridCellAlignment.End">
                            <FluentButton @onclick="() => IdentifyGroup(selectedBridge.Id, context.Id)" IconStart="@(new Icons.Regular.Size16.Lightbulb())">Identify</FluentButton>
                        </TemplateColumn>
                    </FluentDataGrid>
                </FluentCard>
            }
            else
            {
                <FluentText As="TextTag.Paragraph">No entertainment groups found for this bridge.</FluentText>
            }
        }
    }
}
else
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px" HorizontalAlignment="HorizontalAlignment.Center" Style="padding-top: 2rem;">
        <FluentSpinner />
        <FluentText As="TextTag.Paragraph">Loading area details...</FluentText>
    </FluentStack>
}

@code {
	[Parameter]
	public Guid Id { get; set; }

	private ProArea? proArea;
	private string? errorMessage;

	private IQueryable<SimpleEntertainmentGroup>? entertainmentGroups;
	private IEnumerable<Bridge>? bridges;

	private Bridge? selectedBridge;
	private string? selectedBridgeValue;

	private bool HasDisabledBridges =>
		bridges?.Any(b => proArea?.Connections.Select(x => x.Bridge.Id).Contains(b.Id) ?? false) ?? false;
	private bool HasEnabledBridges =>
		bridges?.Any(b => !(proArea?.Connections.Select(x => x.Bridge.Id).Contains(b.Id) ?? false)) ?? false;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			selectedBridge = null;
			selectedBridgeValue = null;
			entertainmentGroups = null;
			bridges = null;

			// Load bridge details
			proArea = await ProAreaDataService.GetProArea(new GuidRequest() { Id = Id });
			if (proArea == null)
			{
				errorMessage = "Area not found.";
				return;
			}

			bridges = await BridgeService.GetBridges();

		}
		catch (Exception ex)
		{
			errorMessage = $"Failed to load area details: {ex.Message}";
		}
	}

	private async Task ShowEditNameDialog()
	{
		if (proArea == null)
			return;

		var result = await DialogService.ShowDialogAsync<EditNameDialog>(options =>
		{
			options.Width = "400px";
			options.Header.Title = "Edit Area Name";
			options.Footer.PrimaryAction.Label = "Save";
			options.Footer.SecondaryAction.Label = "Cancel";
			options.Parameters = new Dictionary<string, object?>
			{
				[nameof(EditNameDialog.Content)] = proArea.Name ?? string.Empty
			};
		});

		if (!result.Cancelled && result.Value is string newName && !string.IsNullOrWhiteSpace(newName))
		{
			try
			{
				var proAreaResult = await ProAreaDataService.UpdateProArea(new UpdateProAreaRequest() { Id = proArea.Id, Name = newName });
				proArea = proAreaResult;
				await NotificationService.ShowSuccessToastAsync("Name updated successfully.");
				StateHasChanged();
			}
			catch (Exception ex)
			{
				await NotificationService.ShowErrorToastAsync($"Failed to update name: {ex.Message}");
			}
		}
	}

	private async Task ShowDeleteConfirmation()
	{
		if (proArea == null)
			return;

		var result = await DialogService.ShowConfirmationAsync(
			"Are you sure you want to delete this area?"
			, "Delete", "Cancel", "Confirm Delete");

		if (!result.Cancelled)
		{
			try
			{
				await ProAreaDataService.DeleteProArea(new GuidRequest { Id = proArea.Id });
				await NotificationService.ShowSuccessToastAsync("Area deleted successfully.");
				Navigation.NavigateTo("");
			}
			catch (Exception ex)
			{
				await NotificationService.ShowErrorToastAsync($"Failed to delete area: {ex.Message}");
			}
		}
	}

	private async Task OnBridgeIdSelected(string bridgeId)
	{
		entertainmentGroups = null;
		selectedBridge = bridges?.FirstOrDefault(b => b.Id.ToString() == bridgeId);
		selectedBridgeValue = bridgeId;
		StateHasChanged();

		if (selectedBridge == null)
			return;

		// Load entertainment groups
		var result = await HueSetupService.GetEntertainmentGroupsAsync(new HueLightDJ.Services.Interfaces.Models.Requests.HueSetupRequest()
		{
			Ip = selectedBridge.Ip,
			Key = selectedBridge.Username
		});
		entertainmentGroups = result.Groups.AsQueryable();

		StateHasChanged();
	}

	private async Task AddToArea(Guid bridgeId, Guid groupId, string? name)
	{
		if (proArea == null)
			return;

		var result = await ProAreaDataService.AddBridgeGroup(new AddBridgeGroupRequest
		{
			ProAreaId = proArea.Id,
			BridgeId = bridgeId,
			GroupId = groupId,
			Name = name
		});

		await OnInitializedAsync();

		StateHasChanged();
	}

	private async Task IdentifyGroup(Guid bridgeId, Guid groupId)
	{
		if (proArea == null)
			return;

		var bridge = await BridgeService.GetBridge(new GuidRequest() { Id = bridgeId });
		if (bridge == null)
			throw new Exception($"Bridge not found: {bridgeId}");

		await HueSetupService.IdentifyGroupsAsync(new HueLightDJ.Services.Interfaces.Models.Requests.HueSetupRequest
			{
				Ip = bridge.Ip,
				Key = bridge.Username,
				GroupId = groupId
			});

		
	}

	private async Task RemoveConnection(Guid connectionId)
	{
		await ProAreaDataService.DeleteBridgeGroup(new GuidRequest
		{
			Id = connectionId,
		});

		await OnInitializedAsync();

		StateHasChanged();
	}
}

