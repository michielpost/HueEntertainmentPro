@page "/bridge/{Id:guid}"
@page "/bridge/{*Ip}"
@using HueApi.Models.Clip
@using HueEntertainmentPro.Client.Services
@using HueEntertainmentPro.Client.Shared.ResourceExplorerComponents
@using HueEntertainmentPro.Shared.Interfaces
@using HueEntertainmentPro.Shared.Models
@using HueEntertainmentPro.Shared.Models.Requests
@using HueLightDJ.Services.Interfaces
@using HueLightDJ.Services.Interfaces.Models
@using System.Text.Json
@inject IBridgeDataService BridgeService
@inject IHueSetupService HueSetupService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject INotificationService NotificationService
@inject ResourceExplorerService ResourceExplorerService

<PageTitle>Bridge Details</PageTitle>

<h1>Bridge Details</h1>

@if (errorMessage != null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Style="margin-bottom: 16px;">
        @errorMessage
    </FluentMessageBar>
}

@if (bridge != null)
{
    <FluentCard Class="page-card" Style="padding: 1.5rem; margin-bottom: 1.5rem;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
            <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Semibold">@bridge.Name</FluentText>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
                <FluentText As="TextTag.Paragraph">Bridge ID: @bridge.BridgeId</FluentText>
                <FluentText As="TextTag.Paragraph">IP: @bridge.Ip</FluentText>
            </FluentStack>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10px" Style="margin-top: 8px;">
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ShowEditNameDialog" IconStart="@(new Icons.Regular.Size16.Edit())">Edit Name</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ShowEditIpDialog" IconStart="@(new Icons.Regular.Size16.NetworkAdapter())">Edit IP</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" @onclick="ShowDeleteConfirmation" IconStart="@(new Icons.Regular.Size16.Delete())">Delete Bridge</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <h3>Entertainment Groups</h3>
    @if (entertainmentGroups == null)
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px" VerticalAlignment="VerticalAlignment.Center">
            <FluentSpinner />
            <FluentText As="TextTag.Paragraph">Loading entertainment groups...</FluentText>
        </FluentStack>
    }
    else if (entertainmentGroups.Any())
    {
        <FluentCard Class="page-card" Appearance="CardAppearance.Subtle" Style="padding: 1rem;">
            <FluentDataGrid Items="@entertainmentGroups" TGridItem="SimpleEntertainmentGroup" RowSize="DataGridRowSize.Medium">
                <PropertyColumn Title="Name" Property="@(g => g.Name)" Sortable="true" Align="DataGridCellAlignment.Start" />
                <PropertyColumn Title="Lights" Property="@(g => g.LightCount)" Sortable="true" Align="DataGridCellAlignment.Start" />
            </FluentDataGrid>
        </FluentCard>
    }
    else
    {
        <FluentText As="TextTag.Paragraph">No entertainment groups found for this bridge.</FluentText>
    }
}
else if (Id.HasValue)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px" HorizontalAlignment="HorizontalAlignment.Center" Style="padding-top: 2rem;">
        <FluentSpinner />
        <FluentText As="TextTag.Paragraph">Loading bridge details...</FluentText>
    </FluentStack>
}

@if (bridgeConfig == null && errorMessage == null)
{
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px" VerticalAlignment="VerticalAlignment.Center" Style="margin-top: 1rem;">
        <FluentSpinner />
        <FluentText As="TextTag.Paragraph">Loading bridge config...</FluentText>
    </FluentStack>
}
else if (bridgeConfig != null)
{
    <h3>Bridge Config</h3>
    <FluentCard Class="page-card" Style="padding: 1rem; margin-bottom: 1rem;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="8px">
            @if (Id.HasValue)
            {
                <FluentText As="TextTag.Paragraph">
                    Explore more bridge details on the <a href="resource-explorer/@Id">Resource Explorer</a>.
                </FluentText>
            }
            <FluentText As="TextTag.Paragraph">
                View <a href="http://@Ip/description.xml" target="_blank">description.xml</a>.
            </FluentText>
        </FluentStack>
    </FluentCard>

    <JsonViewer Element="@JsonSerializer.SerializeToElement(bridgeConfig)" />
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    [Parameter]
    public string? Ip { get; set; }

    private Bridge? bridge;
    private BridgeConfig? bridgeConfig;
    private IQueryable<SimpleEntertainmentGroup>? entertainmentGroups;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            bridgeConfig = null;
            entertainmentGroups = null;

            // Load bridge details
            if (Id.HasValue)
            {
                bridge = await BridgeService.GetBridge(new GuidRequest() { Id = Id.Value });
                Ip = bridge?.Ip;
            }

            if (bridge == null && Ip == null)
            {
                errorMessage = "Bridge not found.";
                return;
            }

            if (bridge != null)
            {
                //TODO: Why does fail when using bridge (which includes key) and returns more data?
                var localHueClient = ResourceExplorerService.GetHueClient(bridge.Ip);
                bridgeConfig = await localHueClient.GetConfigAsync();

                // Load entertainment groups
                var result = await HueSetupService.GetEntertainmentGroupsAsync(new HueLightDJ.Services.Interfaces.Models.Requests.HueSetupRequest()
                {
                    Ip = bridge.Ip,
                    Key = bridge.Username
                });
                entertainmentGroups = result.Groups.AsQueryable();
            }
            else if (Ip != null)
            {
                var localHueClient = ResourceExplorerService.GetHueClient(Ip);
                bridgeConfig = await localHueClient.GetConfigAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load bridge details: {ex.Message}";
        }
    }

    private async Task ShowEditNameDialog()
    {
        if (bridge == null)
            return;

        var result = await DialogService.ShowDialogAsync<EditNameDialog>(options =>
        {
            options.Width = "400px";
            options.Header.Title = "Edit Bridge Name";
            options.Footer.PrimaryAction.Label = "Save";
            options.Footer.SecondaryAction.Label = "Cancel";
            options.Parameters = new Dictionary<string, object?>
            {
                [nameof(EditNameDialog.Content)] = bridge.Name ?? string.Empty
            };
        });

        if (!result.Cancelled && result.Value is string newName && !string.IsNullOrWhiteSpace(newName))
        {
            try
            {
                var bridgeResult = await BridgeService.UpdateBridge(new UpdateBridgeRequest() { Id = bridge.Id, Name = newName, Ip = bridge.Ip ?? string.Empty });
                bridge = bridgeResult;
                await NotificationService.ShowSuccessToastAsync("Bridge name updated successfully.");
                StateHasChanged();
            }
            catch (Exception ex)
            {
                await NotificationService.ShowErrorToastAsync($"Failed to update bridge name: {ex.Message}");
            }
        }
    }

    private async Task ShowEditIpDialog()
    {
        if (bridge == null)
            return;

        var result = await DialogService.ShowDialogAsync<EditIpDialog>(options =>
        {
            options.Width = "400px";
            options.Header.Title = "Edit Bridge IP";
            options.Footer.PrimaryAction.Label = "Save";
            options.Footer.SecondaryAction.Label = "Cancel";
            options.Parameters = new Dictionary<string, object?>
            {
                [nameof(EditIpDialog.Content)] = bridge.Ip ?? string.Empty
            };
        });

        if (!result.Cancelled && result.Value is string newIp && !string.IsNullOrWhiteSpace(newIp))
        {
            try
            {
                var bridgeResult = await BridgeService.UpdateBridge(new UpdateBridgeRequest() { Id = bridge.Id, Name = bridge.Name ?? string.Empty, Ip = newIp });
                bridge = bridgeResult;
                Ip = bridge?.Ip;
                await NotificationService.ShowSuccessToastAsync("Bridge IP updated successfully.");
                StateHasChanged();
            }
            catch (Exception ex)
            {
                await NotificationService.ShowErrorToastAsync($"Failed to update bridge IP: {ex.Message}");
            }
        }
    }

    private async Task ShowDeleteConfirmation()
    {
        if (bridge == null)
            return;

        var result = await DialogService.ShowConfirmationAsync(
            "Are you sure you want to delete this bridge?"
            , "Delete", "Cancel", "Confirm Delete");

        if (!result.Cancelled)
        {
            try
            {
                await BridgeService.DeleteBridge(new GuidRequest { Id = bridge.Id });
                await NotificationService.ShowSuccessToastAsync("Bridge deleted successfully.");
                Navigation.NavigateTo("bridges");
            }
            catch (Exception ex)
            {
                await NotificationService.ShowErrorToastAsync($"Failed to delete bridge: {ex.Message}");
            }
        }
    }
}

