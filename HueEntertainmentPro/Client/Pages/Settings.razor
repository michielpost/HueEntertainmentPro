@page "/settings"
@inject IThemeService ThemeService

<PageTitle>Settings</PageTitle>

<h1>Settings</h1>

<FluentCard Class="page-card" Style="padding: 1.5rem; max-width: 500px;">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px">
        <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold">Appearance</FluentText>
        <FluentSelect Label="Theme"
                      Width="250px"
                      Items="@(Enum.GetValues<ThemeMode>())"
                      TOption="ThemeMode"
                      TValue="ThemeMode"
                      Value="@Mode"
                      ValueChanged="@OnModeChangedAsync" />
    </FluentStack>
</FluentCard>

@code {
    public ThemeMode Mode { get; set; } = ThemeMode.System;

    protected override async Task OnInitializedAsync()
    {
        var settings = await ThemeService.GetThemeSettingsAsync();
        Mode = settings?.Mode ?? ThemeMode.System;
    }

    private async Task OnModeChangedAsync(ThemeMode mode)
    {
        Mode = mode;
        await ThemeService.SetThemeAsync(mode);
    }
}
