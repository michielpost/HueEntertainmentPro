@page "/"
@using HueEntertainmentPro.Shared.Interfaces
@using HueEntertainmentPro.Shared.Models
@using HueEntertainmentPro.Shared.Models.Requests
@inject IBridgeDataService BridgeDataService
@inject IProAreaDataService ProAreaDataService
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Hue Entertainment Pro</PageTitle>

@if (bridges == null || proAreas == null)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px" HorizontalAlignment="HorizontalAlignment.Center" Style="padding-top: 4rem;">
        <FluentSpinner />
        <FluentText As="TextTag.Paragraph">Loading your setup...</FluentText>
    </FluentStack>
}
else if (!bridges.Any() || !proAreas.Any())
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px">
        <h1>Setup</h1>
        <FluentText Class="page-subtitle" As="TextTag.Paragraph">
            Combine entertainment areas from multiple bridges into one entertainment area.
            Display effects and visualize your room in 3d.
        </FluentText>

        <FluentCard Class="page-card" Style="padding: 1.5rem;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Semibold">1) Start by adding some bridges</FluentText>
                @if (bridges.Any())
                {
                    <FluentText As="TextTag.Paragraph">You have already added @bridges.Count() bridge(s). You can add more.</FluentText>
                    <FluentButton @onclick="OpenAddBridgeDialog" Appearance="ButtonAppearance.Primary">Add Another Bridge</FluentButton>
                }
                else
                {
                    <FluentText As="TextTag.Paragraph">You haven't added any bridges yet.</FluentText>
                    <FluentText As="TextTag.Paragraph">Use the "Add Bridge" button below to add your Hue Bridges. You can add multiple bridges.</FluentText>
                    <FluentButton @onclick="OpenAddBridgeDialog" Appearance="ButtonAppearance.Primary">Add Bridge</FluentButton>
                }
            </FluentStack>
        </FluentCard>

        <FluentCard Class="page-card" Style="padding: 1.5rem;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Semibold">2) Combine multiple entertainment areas into one</FluentText>
                <FluentText As="TextTag.Paragraph">Don't worry, you can also start with 1 bridge and 1 area to see what Hue Entertainment Pro can do.</FluentText>
                @if (bridges.Any())
                {
                    <FluentText As="TextTag.Paragraph">You have added @bridges.Count() bridge(s). Now you can create entertainment areas by combining entertainment groups from your bridges.</FluentText>
                    <FluentButton @onclick="OpenAddAreaDialog" Appearance="ButtonAppearance.Primary">Add Area</FluentButton>
                }
                else
                {
                    <FluentText As="TextTag.Paragraph">Once you have added some bridges, you can create entertainment areas by combining entertainment groups from your bridges.</FluentText>
                }
            </FluentStack>
        </FluentCard>
    </FluentStack>
}
else if (proAreas.Any())
{
    <h1>Entertainment Areas</h1>
    <FluentText Class="page-subtitle" As="TextTag.Paragraph">Combined entertainment areas spanning one or more bridges. Start an area to control its lights.</FluentText>

    <div class="page-actions">
        <FluentButton @onclick="OpenAddAreaDialog" Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())">Add Area</FluentButton>
    </div>

    <FluentGrid Spacing="3" AdaptiveRendering="true" Justify="JustifyContent.FlexStart">
        @foreach (var area in proAreas)
        {
            <FluentGridItem Xs="12" Sm="6">
                <FluentCard Class="page-card" Appearance="CardAppearance.Subtle" Style="padding: 1.25rem;">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                        <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Bold">@area.Name</FluentText>
                        @if (area.Connections.Any())
                        {
                            <FluentText As="TextTag.Paragraph">Entertainment Groups:</FluentText>
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="4px">
                                @foreach (var conn in area.Connections)
                                {
                                    <FluentText As="TextTag.Paragraph">
                                        <FluentIcon Value="@(new Icons.Regular.Size12.Circle())" /> @conn.Name (@conn.Bridge.Ip / @conn.Bridge.Name)
                                    </FluentText>
                                }
                            </FluentStack>
                        }
                        else
                        {
                            <FluentText As="TextTag.Paragraph">No bridges connected</FluentText>
                        }

                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" Style="margin-top: 8px;">
                            <FluentButton @onclick="() => NavigateToArea(area.Id)" IconStart="@(new Icons.Regular.Size16.Edit())">Edit</FluentButton>
                            @if (area.Connections.Any())
                            {
                                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="() => NavigateToPlay(area.Id)" IconStart="@(new Icons.Regular.Size16.Play())">Start</FluentButton>
                            }
                        </FluentStack>
                    </FluentStack>
                </FluentCard>
            </FluentGridItem>
        }
    </FluentGrid>
}

<h2>Demo Areas</h2>

<FluentGrid Spacing="3" AdaptiveRendering="true" Justify="JustifyContent.FlexStart">
    <FluentGridItem Xs="12" Sm="6">
        <FluentCard Class="page-card" Appearance="CardAppearance.Subtle" Style="padding: 1.25rem;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Bold">Grid Demo</FluentText>
                <FluentText As="TextTag.Paragraph">2 bridges with lights in a grid layout</FluentText>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="() => NavigateToPlay(ProAreaPlay.demo1Id)" IconStart="@(new Icons.Regular.Size16.Play())">Start</FluentButton>
            </FluentStack>
        </FluentCard>
    </FluentGridItem>

    <FluentGridItem Xs="12" Sm="6">
        <FluentCard Class="page-card" Appearance="CardAppearance.Subtle" Style="padding: 1.25rem;">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px">
                <FluentText As="TextTag.H4" Size="TextSize.Size500" Weight="TextWeight.Bold">Star Demo</FluentText>
                <FluentText As="TextTag.Paragraph">Q42 Office Star Layout (32 lights)</FluentText>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="() => NavigateToPlay(ProAreaPlay.demo2Id)" IconStart="@(new Icons.Regular.Size16.Play())">Start</FluentButton>
            </FluentStack>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>


@code {
    private IEnumerable<Bridge>? bridges;
    private IEnumerable<ProArea>? proAreas;

    protected override async Task OnInitializedAsync()
    {
        bridges = await BridgeDataService.GetBridges();
        proAreas = await ProAreaDataService.GetProAreas();
    }

    private async Task OpenAddBridgeDialog()
    {
        var result = await DialogService.ShowDialogAsync<AddBridgeDialog>(options =>
        {
            options.Header.Title = "Add a bridge";
        });

        await OnInitializedAsync();
        StateHasChanged();
    }

    private async Task OpenAddAreaDialog()
    {
        var number = proAreas?.Count() + 1;

        var area = await ProAreaDataService.CreateProArea(new CreateProAreaRequest
        {
            Name = $"Pro Entertainment Area {number}"
        });

        NavigateToArea(area.Id);
    }

    private void NavigateToArea(Guid id)
    {
        Navigation.NavigateTo($"proarea/{id}");
    }

    private void NavigateToPlay(Guid id)
    {
        Navigation.NavigateTo($"play/{id}");
    }

}
