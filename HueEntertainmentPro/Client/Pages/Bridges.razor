@page "/bridges"
@using HueEntertainmentPro.Shared.Models
@using HueEntertainmentPro.Shared.Models.Requests
@using HueEntertainmentPro.Shared.Interfaces
@inject IBridgeDataService BridgeDataService
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Bridges</PageTitle>

<h1>Bridges</h1>

<div class="page-actions">
    <FluentButton @onclick="OpenAddDialog" Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())">Add Bridge</FluentButton>
</div>

@if (bridges == null)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px" HorizontalAlignment="HorizontalAlignment.Center" Style="padding-top: 2rem;">
        <FluentSpinner />
        <FluentText As="TextTag.Paragraph">Loading bridges...</FluentText>
    </FluentStack>
}
else if (!bridges.Any())
{
    <FluentCard Class="page-card" Appearance="CardAppearance.Subtle">
        <div class="empty-state">
            <FluentIcon Value="@(new Icons.Regular.Size48.Lightbulb())" Color="Color.Disabled" />
            <h3>No bridges yet</h3>
            <FluentText As="TextTag.Paragraph">Add your first Hue Bridge to get started. Make sure your bridge is connected to the same network.</FluentText>
            <FluentButton @onclick="OpenAddDialog" Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())">Add Bridge</FluentButton>
        </div>
    </FluentCard>
}
else
{
    <FluentCard Class="page-card" Appearance="CardAppearance.Subtle" Style="padding: 1rem;">
        <FluentDataGrid Id="bridgegrid" Items="@bridges" GridTemplateColumns="2fr 2fr 2fr auto" TGridItem="Bridge" RowSize="DataGridRowSize.Medium">
            <TemplateColumn Title="Name" Sortable="true" Align="DataGridCellAlignment.Start">
                <NavLink href="@($"bridge/{context.Id}")">@context.Name</NavLink>
            </TemplateColumn>
            <PropertyColumn Title="IP" Property="@(b => b.Ip)" Sortable="true" Align="DataGridCellAlignment.Start" />
            <PropertyColumn Title="Id" Property="@(b => b.Id)" Sortable="true" Align="DataGridCellAlignment.Start" />
            <TemplateColumn Title="" Align="DataGridCellAlignment.End">
                <NavLink href="@($"bridge/{context.Id}")" title="Edit">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" />
                </NavLink>
            </TemplateColumn>
        </FluentDataGrid>
    </FluentCard>
}


@code {
    private IQueryable<Bridge>? bridges;

    protected override async Task OnInitializedAsync()
    {
        var result = await BridgeDataService.GetBridges();
        bridges = result.AsQueryable();
    }

    private async Task OpenAddDialog()
    {
        var result = await DialogService.ShowDialogAsync<AddBridgeDialog>(options =>
        {
            options.Header.Title = "Add a bridge";
        });

        await OnInitializedAsync();
        StateHasChanged();
    }

    private void NavigateToBridgeDetails(Guid id)
    {
        Navigation.NavigateTo($"bridge/{id}");
    }
}
