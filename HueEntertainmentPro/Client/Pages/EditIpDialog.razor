@inherits FluentDialogInstance

<FluentDialogBody>
    <FluentTextInput Label="Bridge IP" @bind-Value="Content" Style="width: 100%;" />
</FluentDialogBody>

@code {
    [Parameter]
    public string Content { get; set; } = string.Empty;

    protected override void OnInitializeDialog(DialogOptionsHeader header, DialogOptionsFooter footer)
    {
        header.Title = "Edit Bridge IP";
        footer.PrimaryAction.Label = "Save";
        footer.SecondaryAction.Label = "Cancel";
    }

    protected override async Task OnActionClickedAsync(bool primary)
    {
        if (primary)
            await DialogInstance.CloseAsync(Content);
        else
            await DialogInstance.CancelAsync();
    }
}
