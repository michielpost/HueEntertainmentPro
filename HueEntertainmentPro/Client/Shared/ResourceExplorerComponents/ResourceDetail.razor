@using HueApi
@using HueApi.Models
@using HueEntertainmentPro.Client.Services
@using System.Text.Json
@inject NavigationManager NavigationManager
@inject ResourceExplorerService ResourceExplorerService
@using FluentUIOrientation = Microsoft.FluentUI.AspNetCore.Components.Orientation
@using FluentUIVerticalAlignment = Microsoft.FluentUI.AspNetCore.Components.VerticalAlignment

@if (Bridge != null && HueResource != null)
{
    <FluentStack Class="breadcrumb" Orientation="FluentUIOrientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Start" VerticalAlignment="FluentUIVerticalAlignment.Center">
        <FluentLink Href="resource-explorer">Bridges</FluentLink>
        <FluentText As="TextTag.Span">/</FluentText>
        <FluentLink Href="@ResourceExplorerService.CreateResourceLink(Bridge.Id, null)">@Bridge.Name (@Bridge.Ip)</FluentLink>
        <FluentText As="TextTag.Span">/</FluentText>
        <FluentLink Href="@ResourceExplorerService.CreateResourceLink(Bridge.Id, Rtype)">@Rtype</FluentLink>
        <FluentText As="TextTag.Span">/</FluentText>
        <FluentText As="TextTag.Span">@Rid</FluentText>
    </FluentStack>

    <h3>Resource Detail</h3>

    <HueResourceViewer Bridge="@Bridge" Resource="@HueResource" />

   

}
else
{
    <FluentSpinner />
}

@code {
    [Parameter]
    public HueEntertainmentPro.Shared.Models.Bridge? Bridge { get; set; }

    [Parameter]
    public required string Rtype { get; set; }

    [Parameter]
    public Guid? Rid { get; set; }

    private HueResource? HueResource = null;

    protected override async Task OnParametersSetAsync()
    {
        if (Bridge != null)
        {
            var localHueApi = ResourceExplorerService.GetHueClient(Bridge);

            var resources = await localHueApi.GetResourceAsync(Rtype, Rid);

            HueResource = resources.Data.FirstOrDefault();
        }
    }
}


